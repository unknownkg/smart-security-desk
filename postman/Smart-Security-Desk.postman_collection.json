{
  "info": {
    "name": "Smart Security Desk — TC-01–TC-08",
    "description": "Запусти сервер через npm start, импортируй коллекцию в Postman и запусти все запросы по порядку через средство запуска коллекций (Collection Runner). По умолчанию baseUrl = http://localhost:3000. Коллекция создаёт тестовое событие и два инцидента в data/db.json; TC-05 меняет статус первого инцидента. Результаты проверок отображаются при запуске, заранее не записаны.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "incidentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "newFixtureId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "TC-01 — GET проверки сервиса",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('status = ok', () => pm.expect(pm.response.json().status).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-02 — POST корректного события",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"motion\",\n  \"cameraId\": \"CAM-01\",\n  \"severity\": \"high\",\n  \"message\": \"Движение у главного входа\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Событие сохранено с заданными полями', () => { const body = pm.response.json(); pm.expect(body.type).to.eql('motion'); pm.expect(body.cameraId).to.eql('CAM-01'); pm.expect(body.severity).to.eql('high'); pm.expect(body.message).to.eql('Движение у главного входа'); pm.expect(body).to.have.property('id'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-03 — POST события без cameraId",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"type\": \"motion\",\n  \"severity\": \"high\",\n  \"message\": \"Движение у главного входа\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/events",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "events"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Ответ содержит ошибку', () => pm.expect(pm.response.json()).to.have.property('error'));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-04 — POST инцидента",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Подозрительное движение\",\n  \"cameraId\": \"CAM-01\",\n  \"severity\": \"high\",\n  \"description\": \"Событие после 22:00\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/incidents",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents"
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('incidentId');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "pm.test('Инцидент создан со статусом new и ID', () => { const body = pm.response.json(); pm.expect(body.status).to.eql('new'); pm.expect(body).to.have.property('id'); pm.expect(body.id).not.to.be.oneOf([null, '']); pm.expect(body.title).to.eql('Подозрительное движение'); });",
              "if (pm.response.code === 201) { const body = pm.response.json(); if (body.id !== undefined && body.id !== null && body.id !== '') pm.collectionVariables.set('incidentId', String(body.id)); }"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-05 — PATCH статуса in_progress",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"in_progress\",\n  \"assignee\": \"Operator-01\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/incidents/{{incidentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents",
            "{{incidentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ID из TC-04 задан', () => pm.expect(pm.collectionVariables.get('incidentId')).to.be.a('string').and.not.empty);",
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Статус изменён на in_progress', () => { const body = pm.response.json(); pm.expect(String(body.id)).to.eql(pm.collectionVariables.get('incidentId')); pm.expect(body.status).to.eql('in_progress'); pm.expect(body.assignee).to.eql('Operator-01'); });"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-06 — PATCH недопустимого статуса closed",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"closed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/incidents/{{incidentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents",
            "{{incidentId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('ID из TC-04 задан', () => pm.expect(pm.collectionVariables.get('incidentId')).to.be.a('string').and.not.empty);",
              "pm.test('HTTP 400', () => pm.response.to.have.status(400));",
              "pm.test('Ответ содержит ошибку', () => pm.expect(pm.response.json()).to.have.property('error'));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-07 — PATCH неизвестной камеры",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"offline\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/cameras/nonexistent-{{$guid}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "cameras",
            "nonexistent-{{$guid}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 404', () => pm.response.to.have.status(404));",
              "pm.test('Ответ содержит ошибку', () => pm.expect(pm.response.json()).to.have.property('error'));"
            ]
          }
        }
      ]
    },
    {
      "name": "TC-08 — GET инцидентов со статусом new",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/incidents?status=new",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "incidents"
          ],
          "query": [
            {
              "key": "status",
              "value": "new"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.unset('newFixtureId');",
              "pm.sendRequest({ url: pm.variables.get('baseUrl') + '/api/incidents', method: 'POST', header: { 'Content-Type': 'application/json' }, body: { mode: 'raw', raw: JSON.stringify({ title: 'TC-08: проверка фильтра', cameraId: 'CAM-01', severity: 'medium', description: 'Тестовый инцидент для проверки фильтра' }) } }, (error, response) => {",
              "  pm.test('TC-08: тестовый инцидент создан', () => { pm.expect(error).to.be.null; pm.expect(response.code).to.eql(201); pm.expect(response.json().status).to.eql('new'); pm.expect(response.json()).to.have.property('id'); });",
              "  if (!error && response.code === 201) pm.collectionVariables.set('newFixtureId', String(response.json().id));",
              "});"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Все возвращённые инциденты имеют статус new', () => { const items = pm.response.json(); pm.expect(items).to.be.an('array').that.is.not.empty; items.forEach(item => pm.expect(item.status).to.eql('new')); });",
              "pm.test('В результате есть созданный тестовый инцидент', () => { const id = pm.collectionVariables.get('newFixtureId'); pm.expect(id).to.be.a('string').and.not.empty; pm.expect(pm.response.json().some(item => String(item.id) === id)).to.eql(true); });"
            ]
          }
        }
      ]
    }
  ]
}
